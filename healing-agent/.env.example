# Copy this file to `.env` and fill in your values.
# The real `.env` is gitignored — never commit it.

# ── Gemini API (log-monitor analysis) ────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Anthropic API (RCA agent — Claude) ───────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
MAX_REACT_ITERATIONS=15

# ── GitHub (RCA agent — code retrieval) ──────────────────────────────────────
# Classic PAT with "repo" scope: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_pat_here
# Default org/user to look for repos in
GITHUB_ORG=varunesh-ra

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=healing_agent_db
DB_USER=root
DB_PASSWORD=your_db_password_here

# ── Log Source ────────────────────────────────────────────────────────────────
# "local" to tail a file on disk, "datadog" to poll the Datadog API
LOG_SOURCE=local

# Local file (used when LOG_SOURCE=local)
LOG_FILE_PATH=../bank-application/logs/banking-app.log
LOG_CHECK_INTERVAL=2

# Datadog (used when LOG_SOURCE=datadog)
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_application_key_here
DD_SITE=datadoghq.com
DD_QUERY=service:banking-app

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=INFO
