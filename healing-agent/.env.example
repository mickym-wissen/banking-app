# Copy this file to `.env` and fill in your values.
# The real `.env` is gitignored — never commit it.

# Google Gemini API (used by log-monitor pipeline)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (used by GitHub RCA agent — free at console.groq.com)
# Model: llama-3.3-70b-versatile (128k context, fast, free tier)
GROQ_API_KEY=gsk_your_groq_key_here

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=healing_agent_db
DB_USER=root
DB_PASSWORD=your_db_password_here

# ── Log Source ────────────────────────────────────────────────────────────────
# Choose "local" to tail a file on disk, or "datadog" to poll the Datadog API.
LOG_SOURCE=local

# Local file (used when LOG_SOURCE=local)
LOG_FILE_PATH=../bank-application/logs/banking-app.log
LOG_CHECK_INTERVAL=2

# Datadog (used when LOG_SOURCE=datadog)
# Get these from: Datadog → Organization Settings → API Keys / Application Keys
# The Application Key needs the logs_read_data scope.
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_application_key_here
DD_SITE=datadoghq.com          # datadoghq.com | datadoghq.eu | us3.datadoghq.com | us5.datadoghq.com
DD_QUERY=service:banking-app   # any valid Datadog log search query

# ── GitHub Integration ────────────────────────────────────────────────────────
# Used by the RCA agent to clone repos (private) and raise pull requests.
# Create at: https://github.com/settings/tokens → classic token → repo scope
GITHUB_TOKEN=ghp_your_token_here

# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
